rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.uid in [p1h9p2bdxDO3lce6dPkhxM7fhui1
        'ここに管理者のUIDを1つ以上貼り付け'
      ];
    }
    function isSignedIn() { return request.auth != null; }

    match /channels/{channelId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow delete, update: if isAdmin();

      match /messages/{messageId} {
        allow read: if true;
        allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
        allow delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
        allow update: if false;
      }
      match /typing/{uid} {
        allow read: if true;
        allow write: if isSignedIn() && uid == request.auth.uid;
      }
      match /reads/{uid} {
        allow read: if true;
        allow write: if isSignedIn() && uid == request.auth.uid;
      }
    }

    match /presence/{uid} {
      allow read: if true;
      allow write: if isSignedIn() && uid == request.auth.uid;
      allow delete: if isSignedIn() && (uid == request.auth.uid || isAdmin());
    }

    match /users/{uid} {
      allow read: if true;
      allow create: if isSignedIn() && uid == request.auth.uid;
      allow update: if isSignedIn() && (
        (uid == request.auth.uid && request.resource.data.verified == resource.data.verified) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /usernames/{name} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /verifyRequests/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
